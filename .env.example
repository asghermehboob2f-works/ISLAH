# ISLAH Civic Technology Platform - Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT AND SERVER PROVISIONING

# Database Connection (Server-Only)
DATABASE_URL=postgresql://islah_user:password@localhost:5432/islah_db

# Authentication & Session Secrets (Server-Only)
AUTH_SECRET=super_secret_jwt_session_signing_key_change_in_production

# Initial Super Administrator Provisioning (Server-Only - NEVER USE NEXT_PUBLIC_)
INITIAL_ADMIN_EMAIL=admin@islah.gov.in
INITIAL_ADMIN_PASSWORD=AdminMasterPassword2026!

# Cloud Storage Credentials (Server-Only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Computer Vision Service Credentials (Server-Only)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=ai_backend_secret_token_12345

# Public Application Variables (Exposed to Client Browser)
NEXT_PUBLIC_APP_NAME=ISLAH
NEXT_PUBLIC_APP_URL=http://localhost:3000
